@model HowToPrepareModel

<form asp-controller="HowToPrepare" asp-action="Save" method="post">
<div class="main-content" id="sec-homepage-steps">

    <div class="section-header">
        <div>
            <div class="section-heading">HAZIRLIK ADIMLARI</div>
            <div style="font-size:.85rem;color:var(--muted);">"Nasıl Hazırlanırsınız?" bölümü içeriği</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn-add" type="submit">
                <i class="bi bi-floppy"></i> Kaydet & Yayınla
            </button>
        </div>
    </div>

    <div class="content-editor-grid">

        <div class="editor-main">

            @* Bölüm Başlığı *@
            <div class="field-group">
                <div class="field-group-header">
                    <i class="bi bi-type-h2"></i> Bölüm Başlığı
                </div>
                <div class="field-group-body">
                    <div class="two-col-fields">
                        <div>
                            <div class="sublabel">Üst Etiket</div>
                            <input asp-for="Eyebrow" type="text" class="admin-field" />
                        </div>
                        <div>
                            <div class="sublabel">Ana Başlık</div>
                            <input type="text" class="admin-field" asp-for="Title" />
                        </div>
                    </div>
                </div>
            </div>

            @* Görsel *@
            <div class="img-upload-area" style="height:160px;">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=600&q=50" : Model.ImageUrl)"
                    id="stepsImgPreview"
                    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(.4) brightness(.6);border-radius:3px;" />
                <div class="img-upload-overlay">
                    <i class="bi bi-link-45deg" style="font-size:1.4rem;"></i>
                    <div style="font-size:.82rem;">Görsel URL'si</div>
                </div>
            </div>
            <input type="text"
                class="admin-field mt-2"
                asp-for="ImageUrl"
                placeholder="https://example.com/image.jpg"
                oninput="document.getElementById('stepsImgPreview').src = this.value || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=600&q=50'" />
            <div class="field-desc">
                <i class="bi bi-info-circle me-1" style="color:var(--amber)"></i>
                Görsel URL'si yapıştırın — önizleme otomatik güncellenir.
            </div>

            @* Adımlar *@
            <div class="field-group">
                <div class="field-group-header">
                    <i class="bi bi-list-ol"></i> Adımlar
                    <span class="field-hint">Sürükleyerek sıralayabilirsiniz</span>
                </div>
                <div class="field-group-body">
                    <div class="steps-editor" id="stepsEditor">

                        <div class="step-edit-card">
                            <div class="step-edit-top">
                                <div class="step-edit-num">01</div>
                                <div class="step-edit-fields">
                                    <input type="text" class="admin-field"
                                           asp-for="StepItem1Title"
                                           oninput="updateStepPreview()" />
                                    <textarea class="admin-field admin-textarea" rows="2"
                                              asp-for="StepItem1Description"
                                              oninput="updateStepPreview()"></textarea>
                                </div>
                                <div class="step-edit-actions">
                                    <button class="icon-btn" title="Yukarı taşı" onclick="moveStep(this,-1)"><i class="bi bi-chevron-up"></i></button>
                                    <button class="icon-btn" title="Aşağı taşı" onclick="moveStep(this,1)"><i class="bi bi-chevron-down"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="step-edit-card">
                            <div class="step-edit-top">
                                <div class="step-edit-num">02</div>
                                <div class="step-edit-fields">
                                    <input type="text" class="admin-field" asp-for="StepItem2Title" />
                                    <textarea class="admin-field admin-textarea" rows="2"
                                              asp-for="StepItem2Description"></textarea>
                                </div>
                                <div class="step-edit-actions">
                                    <button class="icon-btn" onclick="moveStep(this,-1)"><i class="bi bi-chevron-up"></i></button>
                                    <button class="icon-btn" onclick="moveStep(this,1)"><i class="bi bi-chevron-down"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="step-edit-card">
                            <div class="step-edit-top">
                                <div class="step-edit-num">03</div>
                                <div class="step-edit-fields">
                                    <input type="text" class="admin-field" asp-for="StepItem3Title" />
                                    <textarea class="admin-field admin-textarea" rows="2"
                                              asp-for="StepItem3Description"></textarea>
                                </div>
                                <div class="step-edit-actions">
                                    <button class="icon-btn" onclick="moveStep(this,-1)"><i class="bi bi-chevron-up"></i></button>
                                    <button class="icon-btn" onclick="moveStep(this,1)"><i class="bi bi-chevron-down"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="step-edit-card">
                            <div class="step-edit-top">
                                <div class="step-edit-num">04</div>
                                <div class="step-edit-fields">
                                    <input type="text" class="admin-field" asp-for="StepItem4Title" />
                                    <textarea class="admin-field admin-textarea" rows="2"
                                              asp-for="StepItem4Description"></textarea>
                                </div>
                                <div class="step-edit-actions">
                                    <button class="icon-btn" onclick="moveStep(this,-1)"><i class="bi bi-chevron-up"></i></button>
                                    <button class="icon-btn" onclick="moveStep(this,1)"><i class="bi bi-chevron-down"></i></button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <div class="editor-sidebar">
            <div class="info-box mt-3">
                <div class="info-box-head"><i class="bi bi-clock-history me-1"></i> Son Güncelleme</div>
                <div class="info-box-body">
                    <div class="info-row"><span>Güncelleyen</span><strong>@Model.UpdatedBy</strong></div>
                    <div class="info-row"><span>Tarih</span><strong>@Model.UpdatedAt</strong></div>
                </div>
            </div>
        </div>

    </div>
</div>
</form>