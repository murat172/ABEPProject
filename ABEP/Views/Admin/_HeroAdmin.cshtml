@model HeroModel

<form asp-controller="Hero" asp-action="Save" method="post" >
    <div class="main-content" id="sec-homepage-hero">

        <div class="section-header">
            <div>
                <div class="section-heading">HERO YÖNETİMİ</div>
                <div style="font-size:.85rem;color:var(--muted);">Ana sayfa hero bölümü içeriği</div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn-add" type="submit">
                    <i class="bi bi-floppy"></i> Kaydet & Yayınla
                </button>
            </div>
        </div>

        <div class="content-editor-grid">


            <div class="editor-main">


                <div class="field-group">
                    <div class="field-group-header">
                        <i class="bi bi-text-left"></i> Üst Etiket
                        <span class="field-hint">Hero başlığının üstündeki küçük yazı</span>
                    </div>
                    <div class="field-group-body">
                        <input type="text" class="admin-field" id="hero-eyebrow"
                            asp-for="Eyebrow"/>
                    </div>
                </div>


                <div class="field-group">
                    <div class="field-group-header">
                        <i class="bi bi-type-h1"></i> Ana Başlık
                    </div>
                    <div class="field-group-body">
                        <div class="hero-title-editor">
                            <input type="text" class="admin-field hero-line-input" id="hero-line1" asp-for="TitleLine1"/>
                            <input type="text" class="admin-field hero-line-input accent-line" id="hero-line2" asp-for="TitleLine2" />
                            <input type="text" class="admin-field hero-line-input" id="hero-line3" asp-for="TitleLine3"/>
                        </div>
                        <div class="field-desc">
                            <i class="bi bi-info-circle me-1" style="color:var(--amber)"></i>
                            2. satır otomatik olarak kırmızı (vurgu rengi) gösterilir.
                        </div>
                    </div>
                </div>


                <div class="field-group">
                    <div class="field-group-header">
                        <i class="bi bi-paragraph"></i> Alt Açıklama
                        <span class="field-hint">Başlığın altındaki paragraf metni</span>
                    </div>
                    <div class="field-group-body">
                        <textarea class="admin-field admin-textarea" id="hero-desc" rows="3"
                                oninput="updateCharCount(this,'hero-desc-count',220)" asp-for="SubTitle"></textarea>
                    </div>
                </div>


                <div class="field-group">
                    <div class="field-group-header">
                        <i class="bi bi-hand-index"></i> CTA Butonları
                    </div>
                    <div class="field-group-body">
                        <div class="two-col-fields">
                            <div>
                                <div class="sublabel">Birincil Buton</div>
                                <input type="text" class="admin-field" id="hero-btn1-text" asp-for="Btn1Text" />
                            </div>
                            <div>
                                <div class="sublabel">Birincil Buton Linki</div>
                                <input type="text" class="admin-field" id="hero-btn1-url" asp-for="Btn1Url" />
                            </div>
                            <div>
                                <div class="sublabel">İkincil Buton</div>
                                <input type="text" class="admin-field" id="hero-btn2-text" asp-for="Btn2Text" />
                            </div>
                            <div>
                                <div class="sublabel">İkincil Buton Linki</div>
                                <input type="text" class="admin-field" id="hero-btn2-url" asp-for="Btn2Url" />
                            </div>
                        </div>
                    </div>
                </div>


                <div class="field-group">
                    <div class="field-group-header">
                        <i class="bi bi-image"></i> Arka Plan Görseli
                    </div>
                        <div class="img-upload-area" id="heroImgArea">
                        <img src="@(Model.ImagePath ?? "https://images.unsplash.com/photo-1517022812141-23620dba5c23?w=600&q=50")"
                            alt="Hero bg" id="heroImgPreview"
                            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
                                    filter:grayscale(.5) brightness(.4);border-radius:3px;" />
                        <div class="img-upload-overlay">
                            <i class="bi bi-link-45deg" style="font-size:1.8rem;"></i>
                            <div>Görsel URL'si</div>
                        </div>
                    </div>

                    <input type="text" 
                        class="admin-field mt-2" 
                        id="heroImgUrl" 
                        name="ImagePath"
                        asp-for="ImagePath"
                        placeholder="https://example.com/image.jpg"
                        oninput="previewImgUrl(this.value)" />
                    <div class="field-desc">
                        <i class="bi bi-info-circle me-1" style="color:var(--amber)"></i>
                        Görsel URL'si yapıştırın — önizleme otomatik güncellenir.
                    </div>
                </div>

            </div>

            <div class="editor-sidebar">

                <div class="info-box mt-3">
                    <div class="info-box-head"><i class="bi bi-clock-history me-1"></i> Son Güncelleme</div>
                    <div class="info-box-body">
                        <div class="info-row"><span>Güncelleyen</span><strong>@Model.UpdatedBy</strong></div>
                        <div class="info-row"><span>Tarih</span><strong>@Model.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</strong></div>
                        <div class="info-row"><span>Durum</span>
                            <span class="status-pill @(Model.IsPublished ? "live" : "draft")">
                                @(Model.IsPublished ? "Yayında" : "Taslak")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>