@model ExperiencesModel

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Deneyimler – AfetBilinç</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Barlow+Condensed:wght@500;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <style>
    :root {
      --red:    #C0392B;
      --red-dk: #922B21;
      --amber:  #D35400;
      --dark:   #0D0D0D;
      --mid:    #1A1A1A;
      --surface:#242424;
      --border: rgba(255,255,255,.07);
      --muted:  #888;
      --light:  #F5F1EC;
      --accent: #E74C3C;
    }
    

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--dark);
      color: var(--light);
      font-family: 'Barlow', sans-serif;
      font-weight: 300;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: .4;
    }

    /* ── NAVBAR ── */
    .navbar {
      background: rgba(13,13,13,.95);
      border-bottom: 1px solid rgba(192,57,43,.25);
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(8px);
    }
    .navbar-brand { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 2px; color: var(--light) !important; }
    .navbar-brand span { color: var(--accent); }
    .nav-link { color: rgba(245,241,236,.7) !important; font-size: .85rem; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; transition: color .2s; padding: .4rem .8rem !important; }
    .nav-link:hover, .nav-link.active { color: var(--accent) !important; }
    .btn-nav-alert { background: var(--red); color: #fff; font-size: .78rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; border: none; padding: .45rem 1.1rem; border-radius: 2px; transition: background .2s; text-decoration: none; }
    .btn-nav-alert:hover { background: var(--red-dk); color: #fff; }

    /* ── PAGE HEADER ── */
    .page-header {
      position: relative;
      padding: 5rem 0 4rem;
      overflow: hidden;
    }
    .page-header::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(192,57,43,.12) 0%, transparent 60%);
      pointer-events: none;
    }
    .page-header-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: .6rem;
    }
    .page-header h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 7vw, 5.5rem);
      letter-spacing: 3px;
      line-height: 1;
      margin-bottom: 1rem;
    }
    .page-header p {
      font-size: 1.05rem;
      color: rgba(245,241,236,.65);
      max-width: 560px;
      line-height: 1.7;
    }

    /* ── STAT BAR ── */
    .stat-bar {
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 0;
    }
    .stat-item { text-align: center; }
    .stat-num {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.2rem;
      letter-spacing: 2px;
      color: var(--accent);
      line-height: 1;
    }
    .stat-lbl {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-top: .2rem;
    }

    /* ── FILTERS ── */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      padding: 2rem 0 1.5rem;
      align-items: center;
    }
    .filter-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-right: .5rem;
    }
    .filter-btn {
      background: var(--surface);
      color: rgba(245,241,236,.65);
      border: 1px solid var(--border);
      padding: .35rem .9rem;
      border-radius: 2px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all .2s;
    }
    .filter-btn:hover { border-color: rgba(231,76,60,.4); color: var(--accent); }
    .filter-btn.active { background: rgba(231,76,60,.12); border-color: var(--accent); color: var(--accent); }

    /* ── GRID ── */
    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
      padding-bottom: 3rem;
    }

    /* ── STORY CARD ── */
    .story-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
      position: relative;
      transition: border-color .25s, transform .25s;
      opacity: 0;
      transform: translateY(20px);
    }
    .story-card.visible { opacity: 1; transform: translateY(0); transition: opacity .45s ease, transform .45s ease, border-color .25s, box-shadow .25s; }
    .story-card:hover { border-color: rgba(231,76,60,.3); box-shadow: 0 8px 32px rgba(0,0,0,.35); }

    .card-accent-bar { height: 3px; width: 100%; }
    .accent-red    { background: linear-gradient(90deg, var(--red), var(--accent)); }
    .accent-amber  { background: linear-gradient(90deg, var(--amber), #F39C12); }
    .accent-green  { background: linear-gradient(90deg, #27AE60, #2ECC71); }
    .accent-blue   { background: linear-gradient(90deg, #2980B9, #3498DB); }

    .card-body-inner { padding: 1.5rem; }

    .card-category {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: .25rem .65rem;
      border-radius: 2px;
      margin-bottom: 1rem;
    }
    .cat-earthquake { background: rgba(192,57,43,.2); color: #E74C3C; border: 1px solid rgba(192,57,43,.35); }
    .cat-flood      { background: rgba(41,128,185,.2); color: #3498DB; border: 1px solid rgba(41,128,185,.35); }
    .cat-fire       { background: rgba(211,84,0,.2); color: #E67E22; border: 1px solid rgba(211,84,0,.35); }
    .cat-survival   { background: rgba(39,174,96,.2); color: #2ECC71; border: 1px solid rgba(39,174,96,.35); }

    .card-quote {
      font-size: .97rem;
      line-height: 1.75;
      color: rgba(245,241,236,.82);
      margin-bottom: 1.25rem;
      position: relative;
      padding-left: 1.1rem;
    }
    .card-quote::before {
      content: '';
      position: absolute;
      left: 0;
      top: 4px;
      bottom: 4px;
      width: 2px;
      background: var(--accent);
      border-radius: 2px;
    }

    .card-read-more {
      background: none;
      border: none;
      color: var(--accent);
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      padding: 0;
      transition: color .2s;
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      margin-bottom: 1.25rem;
    }
    .card-read-more:hover { color: var(--red); }

    .card-footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }

    
    .card-author {
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .author-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--mid);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Bebas Neue', sans-serif;
      font-size: .9rem;
      color: var(--accent);
    }
    .author-name {
      font-size: .82rem;
      font-weight: 500;
      color: rgba(245,241,236,.85);
    }
    .author-meta {
      font-size: .73rem;
      color: var(--muted);
      letter-spacing: .3px;
    }
    .card-likes {
      display: flex;
      align-items: center;
      gap: .3rem;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .8rem;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
      transition: color .2s;
      background: none;
      border: none;
    }
    .card-likes:hover, .card-likes.liked { color: var(--accent); }
    .card-likes i { font-size: .95rem; }

    /* ── FEATURED CARD ── */
    .story-card.featured {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .story-card.featured .card-body-inner { padding: 2.25rem; }
    .story-card.featured .card-quote { font-size: 1.08rem; }
    .featured-visual {
      background: linear-gradient(135deg, rgba(192,57,43,.25) 0%, rgba(13,13,13,.8) 100%),
        url('https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=800&q=70') center/cover no-repeat;
      position: relative;
      min-height: 300px;
    }
    .featured-badge {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
      background: var(--red);
      color: #fff;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: .3rem .8rem;
      border-radius: 2px;
    }

    /* ── SUBMIT FORM ── */
    .submit-section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2.5rem;
      margin: 3rem 0;
    }
    .submit-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: .5rem;
    }
    .submit-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      letter-spacing: 2px;
      margin-bottom: .75rem;
    }
    .submit-desc {
      color: rgba(245,241,236,.6);
      font-size: .93rem;
      line-height: 1.7;
      margin-bottom: 2rem;
    }
    .form-group { margin-bottom: 1.25rem; }
    .form-label-custom {
      display: block;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: .45rem;
    }
    .form-control-custom {
      width: 100%;
      background: var(--mid);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--light);
      padding: .75rem 1rem;
      font-family: 'Barlow', sans-serif;
      font-size: .93rem;
      font-weight: 300;
      transition: border-color .2s;
      outline: none;
    }
    .form-control-custom:focus { border-color: rgba(231,76,60,.5); }
    .form-control-custom::placeholder { color: var(--muted); }
    textarea.form-control-custom { resize: vertical; min-height: 130px; }
    select.form-control-custom { appearance: none; cursor: pointer; }

    .char-count {
      font-size: .72rem;
      color: var(--muted);
      text-align: right;
      margin-top: .3rem;
    }
    .char-count.warn { color: var(--amber); }
    .char-count.limit { color: var(--accent); }

    .btn-submit {
      background: var(--red);
      color: #fff;
      border: none;
      padding: .75rem 2rem;
      border-radius: 2px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .88rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .2s;
      display: inline-flex;
      align-items: center;
      gap: .5rem;
    }
    .btn-submit:hover { background: var(--red-dk); }
    .btn-submit:disabled { opacity: .5; cursor: not-allowed; }

    /* ── MODERATION NOTICE ── */
    .mod-notice {
      display: flex;
      align-items: flex-start;
      gap: .75rem;
      background: rgba(211,84,0,.08);
      border: 1px solid rgba(211,84,0,.2);
      border-radius: 2px;
      padding: .9rem 1rem;
      margin-top: 1.25rem;
      font-size: .82rem;
      color: rgba(245,241,236,.6);
      line-height: 1.6;
    }
    .mod-notice i { color: var(--amber); margin-top: 2px; flex-shrink: 0; }

    /* ── TOAST ── */
    .toast-custom {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #1e3a1e;
      border: 1px solid rgba(46,204,113,.3);
      border-radius: 4px;
      padding: 1rem 1.5rem;
      color: #2ECC71;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .88rem;
      font-weight: 700;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: .6rem;
      z-index: 9999;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity .3s, transform .3s;
      pointer-events: none;
    }
    .toast-custom.show { opacity: 1; transform: translateY(0); }

    /* ── FOOTER ── */
    footer {
      background: var(--mid);
      border-top: 1px solid var(--border);
      padding: 4rem 0 2rem;
      position: relative;
    }
    .text-muted{
      color: var(--muted) !important;
    }
    .footer-brand { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; }
    .footer-brand span { color: var(--accent); }
    footer p { font-size: .9rem; color: var(--muted); line-height: 1.6; }
    .footer-heading { font-family: 'Barlow Condensed', sans-serif; font-size: .72rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
    .footer-links { list-style: none; }
    .footer-links li { margin-bottom: .5rem; }
    .footer-links a { color: var(--muted); text-decoration: none; font-size: .9rem; transition: color .2s; }
    .footer-links a:hover { color: var(--accent); }
    .footer-bottom { border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.5rem; font-size: .82rem; color: var(--muted); }
    .footer-bottom a { color: var(--muted); text-decoration: none; }
    .footer-bottom a:hover { color: var(--accent); }

    [data-animate] { opacity: 0; transform: translateY(18px); transition: opacity .45s ease, transform .45s ease; }
    [data-animate].visible { opacity: 1; transform: translateY(0); }

    @@media (max-width: 768px) {
      .story-card.featured { grid-template-columns: 1fr; }
      .featured-visual { min-height: 200px; }
      .stories-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="container" style="position:relative;z-index:2;">
    <div class="page-header-label"><i class="bi bi-chat-quote me-1"></i> Topluluk</div>
    <h1>Deneyimler<br><span style="color:var(--accent);">& Hikayeler</span></h1>
    <p>Afet anlarında yaşananları, aldıkları önlemleri ve bu deneyimlerden çıkardıkları dersleri paylaşan gerçek kişilerin hikayeleri.</p>
  </div>
</div>


<div class="container">

  <!-- FILTER BAR -->
  <div class="filter-bar">
    <span class="filter-label">Filtrele:</span>
    <button class="filter-btn active" onclick="filterCards(this, 'all')">Tümü</button>
    <button class="filter-btn" onclick="filterCards(this, 'earthquake')">Deprem</button>
    <button class="filter-btn" onclick="filterCards(this, 'flood')">Sel / Taşkın</button>
    <button class="filter-btn" onclick="filterCards(this, 'fire')">Yangın</button>
    <button class="filter-btn" onclick="filterCards(this, 'survival')">Hayatta Kalma</button>
  </div>

  <!-- STORIES GRID -->
  @await Html.PartialAsync("_ExperiencesCard", 
    (List<ExperiencesModel>)ViewData["Experiences"]!)

  @if (User.Identity?.IsAuthenticated == true)
  {
  <form asp-controller="Experiences" asp-action="Experiences" method="post">
    <div class="submit-section" data-animate id="hikayeni-paylas">
      <div class="row g-5 align-items-start">
        <div class="col-lg-4">
          <div class="submit-label"><i class="bi bi-pencil-square me-1"></i> Katkıda Bulun</div>
          <div class="submit-title">Hikayeni<br><span style="color:var(--accent);">Paylaş</span></div>
          <p class="submit-desc">
            Deneyimini paylaşmak başkalarının hayatını kurtarabilir. Her gerçek hikaye, bir sonraki afette birileri için rehber olabilir.
          </p>
        </div>
        <div class="col-lg-8">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-custom">Adınız <span style="color:var(--accent);">*</span></label>
                <input type="text" class="form-control-custom" asp-for="FullName" />
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-custom">Şehir / Bölge</label>
                <input type="text" class="form-control-custom" asp-for="City" />
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-custom">Afet Türü <span style="color:var(--accent);">*</span></label>
                <select class="form-control-custom" asp-for="Disaster">
                  <option value="">Seçiniz...</option>
                  <option value="earthquake">Deprem</option>
                  <option value="flood">Sel / Taşkın</option>
                  <option value="fire">Yangın</option>
                  <option value="survival">Hayatta Kalma / Genel</option>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label-custom">Tarih</label>
                <input type="text" class="form-control-custom" asp-for="Date" />
              </div>
            </div>
            <div class="col-12">
              <div class="form-group">
                <label class="form-label-custom">Deneyiminiz <span style="color:var(--accent);">*</span></label>
                <textarea class="form-control-custom" asp-for="Experience" maxlength="1000" oninput="updateCharCount()"></textarea>
                <div class="char-count" id="charCount">0 / 1000</div>
              </div>
            </div>
            <div class="col-12">
              <button class="btn-submit" id="btnSubmit" type="submit">
                <i class="bi bi-send"></i> Hikayemi Gönder
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
  }
  else
  {
    <div class="submit-section" data-animate id="hikayeni-paylas">
      <div class="row g-5 align-items-center">
        <div class="col-lg-4">
          <div class="submit-label"><i class="bi bi-lock me-1"></i> Katkıda Bulun</div>
          <div class="submit-title">Hikayeni<br><span style="color:var(--accent);">Paylaş</span></div>
          <p class="submit-desc">
            Deneyimini paylaşmak başkalarının hayatını kurtarabilir. Her gerçek hikaye, bir sonraki afette birileri için rehber olabilir.
          </p>
        </div>
        <div class="col-lg-8">
          <div style="background:#1a1a1a; border:1px solid rgba(231,76,60,.25); border-radius:8px; padding:2.5rem; text-align:center;">
            <i class="bi bi-person-lock" style="font-size:2.5rem; color:var(--accent); display:block; margin-bottom:1rem;"></i>
            <p style="color:rgba(245,241,236,.7); font-size:1rem; margin-bottom:1.5rem; line-height:1.7;">
              Deneyim paylaşabilmek için <strong style="color:var(--light);">giriş yapmanız</strong> gerekmektedir.
            </p>
            <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
              <a asp-controller="Account" asp-action="Login"
                 style="background:var(--accent); color:#fff; padding:.6rem 1.5rem; border-radius:4px; font-family:'Barlow Condensed',sans-serif; font-weight:600; letter-spacing:1px; text-decoration:none; font-size:.9rem;">
                <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
              </a>
              <a asp-controller="Account" asp-action="Register"
                 style="background:transparent; color:var(--light); padding:.6rem 1.5rem; border-radius:4px; border:1px solid rgba(255,255,255,.15); font-family:'Barlow Condensed',sans-serif; font-weight:600; letter-spacing:1px; text-decoration:none; font-size:.9rem;">
                <i class="bi bi-person-plus me-1"></i> Kayıt Ol
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  }

</div>



<!-- TOAST -->
<div class="toast-custom" id="toast">
  <i class="bi bi-check-circle-fill"></i> Hikayeniz alındı! İnceleme sonrası yayınlanacak.
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Animate on scroll
  const els = document.querySelectorAll('[data-animate]');
  const obs = new IntersectionObserver(entries => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 70);
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.06 });
  els.forEach(el => obs.observe(el));

  // Filter
  function filterCards(btn, cat) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.story-card').forEach(card => {
      const match = cat === 'all' || card.dataset.category === cat;
      card.style.display = match ? '' : 'none';
    });
  }

  // Expand
  function toggleExpand(btn, shortId, fullId) {
    const short = document.getElementById(shortId);
    const full = document.getElementById(fullId);
    const expanded = full.classList.contains('d-none');
    short.classList.toggle('d-none', expanded);
    full.classList.toggle('d-none', !expanded);
    btn.innerHTML = expanded
      ? '<i class="bi bi-chevron-up"></i> Daha Az Göster'
      : '<i class="bi bi-chevron-down"></i> Devamını Oku';
  }

  // Like
  function toggleLike(btn) {
    const liked = btn.classList.toggle('liked');
    const icon = btn.querySelector('i');
    icon.className = liked ? 'bi bi-heart-fill' : 'bi bi-heart';
    const num = parseInt(btn.textContent.trim());
    btn.innerHTML = `<i class="${icon.className}"></i> ${liked ? num + 1 : num - 1}`;
  }

  // Char count
  function updateCharCount() {
    const ta = document.getElementById('inputStory');
    const cc = document.getElementById('charCount');
    const len = ta.value.length;
    cc.textContent = len + ' / 1000';
    cc.className = 'char-count' + (len > 900 ? ' limit' : len > 700 ? ' warn' : '');
  }

  // Submit
  function submitStory() {
    const name = document.getElementById('inputName').value.trim();
    const cat  = document.getElementById('inputCategory').value;
    const story= document.getElementById('inputStory').value.trim();
    if (!name || !cat || !story) {
      alert('Lütfen zorunlu alanları doldurunuz (Ad, Afet Türü, Deneyim).');
      return;
    }
    const btn = document.getElementById('btnSubmit');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Gönderiliyor...';
    setTimeout(() => {
      btn.innerHTML = '<i class="bi bi-send"></i> Hikayemi Gönder';
      btn.disabled = false;
      document.getElementById('inputName').value = '';
      document.getElementById('inputCity').value = '';
      document.getElementById('inputCategory').value = '';
      document.getElementById('inputDate').value = '';
      document.getElementById('inputStory').value = '';
      updateCharCount();
      showToast();
    }, 1200);
  }

  function showToast() {
    const t = document.getElementById('toast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 4000);
  }
</script>
</body>
</html>
