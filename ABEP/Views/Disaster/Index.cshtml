@model ABEP.Models.DisasterIndexViewModel
@{
    ViewData["Title"] = "Afet Türleri – AfetBilinç";

    string RiskBadgeClass(string level) => level switch
    {
        "critical" => "risk-critical",
        "high"     => "risk-high",
        "medium"   => "risk-medium",
        "low"      => "risk-low",
        _          => "risk-medium"
    };

    string RiskLabel(string level) => level switch
    {
        "critical" => "Kritik Risk",
        "high"     => "Yüksek Risk",
        "medium"   => "Orta Risk",
        "low"      => "Düşük Risk",
        _          => level
    };

    string RiskIcon(string level) => level switch
    {
        "critical" => "bi-exclamation-octagon-fill",
        "high"     => "bi-exclamation-triangle-fill",
        "medium"   => "bi-dash-circle-fill",
        "low"      => "bi-check-circle-fill",
        _          => "bi-dash-circle-fill"
    };
}
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Barlow+Condensed:wght@500;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <style>
    :root {
      --red:    #C0392B;
      --red-dk: #922B21;
      --amber:  #D35400;
      --dark:   #0D0D0D;
      --mid:    #1A1A1A;
      --surface:#242424;
      --border: rgba(255,255,255,.07);
      --muted:  #888;
      --light:  #F5F1EC;
      --accent: #E74C3C;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--dark); color: var(--light); font-family: 'Barlow', sans-serif; font-weight: 300; overflow-x: hidden; }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: .4;
    }

    .navbar { background: rgba(13,13,13,.95); border-bottom: 1px solid rgba(192,57,43,.25); padding: 1rem 0; position: sticky; top: 0; z-index: 1000; backdrop-filter: blur(8px); }
    .navbar-brand { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 2px; color: var(--light) !important; }
    .navbar-brand span { color: var(--accent); }
    .nav-link { color: rgba(245,241,236,.7) !important; font-size: .85rem; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; transition: color .2s; padding: .4rem .8rem !important; }
    .nav-link:hover, .nav-link.active { color: var(--accent) !important; }
    .btn-nav-alert { background: var(--red); color: #fff; font-size: .78rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; border: none; padding: .45rem 1.1rem; border-radius: 2px; transition: background .2s; text-decoration: none; }
    .btn-nav-alert:hover { background: var(--red-dk); color: #fff; }

    .page-hero { background: var(--mid); border-bottom: 1px solid var(--border); padding: 4.5rem 0 3.5rem; position: relative; overflow: hidden; }
    .page-hero::before { content: 'AFETLER'; position: absolute; right: -2rem; top: 50%; transform: translateY(-50%); font-family: 'Bebas Neue', sans-serif; font-size: clamp(8rem, 18vw, 16rem); color: rgba(255,255,255,.02); letter-spacing: 8px; pointer-events: none; line-height: 1; }

    .breadcrumb-custom { display: flex; align-items: center; gap: .5rem; font-size: .75rem; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-bottom: 1.5rem; }
    .breadcrumb-custom a { color: var(--muted); text-decoration: none; transition: color .2s; }
    .breadcrumb-custom a:hover { color: var(--accent); }
    .breadcrumb-custom .sep { color: rgba(255,255,255,.2); }
    .breadcrumb-custom .current { color: var(--accent); }

    .page-hero h1 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: 2px; line-height: .95; margin-bottom: 1rem; }
    .page-hero h1 em { color: var(--accent); font-style: normal; }
    .page-hero-sub { font-size: 1rem; color: rgba(245,241,236,.55); max-width: 520px; line-height: 1.75; }

    .filter-bar { background: var(--surface); border-bottom: 1px solid var(--border); padding: 1rem 0; z-index: 99; }
    .filter-btn { background: transparent; color: rgba(245,241,236,.55); border: 1px solid var(--border); font-family: 'Barlow Condensed', sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: .45rem 1.1rem; border-radius: 2px; cursor: pointer; transition: all .2s; white-space: nowrap; }
    .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
    .filter-btn.active { background: var(--red); border-color: var(--red); color: #fff; }

    .search-box { background: rgba(255,255,255,.05); border: 1px solid var(--border); color: var(--light); font-family: 'Barlow', sans-serif; font-size: .88rem; padding: .45rem 1rem .45rem 2.5rem; border-radius: 2px; outline: none; transition: border-color .2s; width: 220px; }
    .search-box:focus { border-color: rgba(231,76,60,.5); }
    .search-box::placeholder { color: var(--muted); }
    .search-wrap { position: relative; }
    .search-wrap i { position: absolute; left: .75rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: .85rem; }

    .result-info { font-size: .8rem; color: var(--muted); letter-spacing: .5px; }
    .result-info strong { color: var(--accent); }

    .featured-card { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 3px; overflow: hidden; display: grid; grid-template-columns: 1fr 1.4fr; min-height: 280px; transition: transform .25s, box-shadow .25s; text-decoration: none; color: inherit; }
    .featured-card:hover { transform: translateY(-4px); box-shadow: 0 16px 50px rgba(192,57,43,.2); color: inherit; text-decoration: none; }
    .featured-img { position: relative; overflow: hidden; }
    .featured-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.4) brightness(.7); transition: filter .4s, transform .4s; }
    .featured-card:hover .featured-img img { filter: grayscale(.1) brightness(.8); transform: scale(1.04); }
    .featured-img-badge { position: absolute; top: 1rem; left: 1rem; background: var(--red); color: #fff; font-family: 'Barlow Condensed', sans-serif; font-size: .7rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: .3rem .75rem; border-radius: 2px; }
    .featured-body { padding: 2.5rem 2rem; display: flex; flex-direction: column; justify-content: center; }
    .featured-body h2 { font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; letter-spacing: 1.5px; line-height: 1; margin-bottom: .75rem; }
    .featured-body p { font-size: .9rem; color: rgba(245,241,236,.55); line-height: 1.7; margin-bottom: 1.5rem; }

    .risk-badge { display: inline-flex; align-items: center; gap: .4rem; font-family: 'Barlow Condensed', sans-serif; font-size: .72rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: .3rem .8rem; border-radius: 2px; margin-bottom: 1rem; }
    .risk-critical { background: rgba(192,57,43,.2); color: #E74C3C; border: 1px solid rgba(192,57,43,.3); }
    .risk-high     { background: rgba(211,84,0,.2);  color: #E67E22; border: 1px solid rgba(211,84,0,.3); }
    .risk-medium   { background: rgba(241,196,15,.15); color: #F1C40F; border: 1px solid rgba(241,196,15,.25); }
    .risk-low      { background: rgba(39,174,96,.15); color: #2ECC71; border: 1px solid rgba(39,174,96,.25); }

    .read-more { display: inline-flex; align-items: center; gap: .5rem; font-family: 'Barlow Condensed', sans-serif; font-size: .85rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); transition: gap .2s; }
    .featured-card:hover .read-more { gap: .85rem; }

    .dis-card { background: var(--surface); border: 1px solid var(--border); border-radius: 3px; overflow: hidden; height: 100%; transition: transform .25s, box-shadow .25s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
    .dis-card:hover { transform: translateY(-5px); box-shadow: 0 12px 40px rgba(0,0,0,.4); color: inherit; text-decoration: none; }
    .dis-card-img { position: relative; overflow: hidden; aspect-ratio: 16/9; }
    .dis-card-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.45) brightness(.65); transition: filter .35s, transform .35s; }
    .dis-card:hover .dis-card-img img { filter: grayscale(.1) brightness(.8); transform: scale(1.05); }
    .dis-icon-overlay { position: absolute; bottom: 1rem; right: 1rem; width: 44px; height: 44px; border-radius: 2px; background: var(--red); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: #fff; }
    .dis-card-body { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
    .dis-card h4 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.2rem; font-weight: 700; letter-spacing: 1px; margin-bottom: .5rem; }
    .dis-card p { font-size: .85rem; color: rgba(245,241,236,.5); line-height: 1.65; flex: 1; margin: 0; }
    .dis-card-footer { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-top: 1px solid var(--border); margin-top: .75rem; }
    .dis-card-footer .arrow { font-family: 'Barlow Condensed', sans-serif; font-size: .78rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); display: flex; align-items: center; gap: .35rem; transition: gap .2s; }
    .dis-card:hover .arrow { gap: .6rem; }
    .module-count { font-size: .72rem; color: var(--muted); letter-spacing: .5px; }

    .sec-divider { display: flex; align-items: center; gap: 1rem; margin: 2.5rem 0 2rem; }
    .sec-divider-label { font-family: 'Barlow Condensed', sans-serif; font-size: .78rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); white-space: nowrap; }
    .sec-divider-line { flex: 1; height: 1px; background: var(--border); }

    .empty-state { text-align: center; padding: 4rem 0; color: var(--muted); }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }

    #progress { position: fixed; top: 0; left: 0; height: 2px; background: var(--accent); z-index: 9999; transition: width .1s linear; }
    [data-animate] { opacity: 0; transform: translateY(20px); transition: opacity .5s ease, transform .5s ease; }
    [data-animate].visible { opacity: 1; transform: translateY(0); }
    .dis-col.hidden { display: none !important; }

    @@media (max-width: 767px) {
      .featured-card { grid-template-columns: 1fr; }
      .featured-img { aspect-ratio: 16/9; }
      .filter-bar .d-flex { overflow-x: auto; }
    }
  </style>
</head>
<body>

<div id="progress"></div>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="container" style="position:relative;z-index:1">
    <div class="breadcrumb-custom">
      <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
      <span class="sep">›</span>
      <span class="current">Afet Türleri</span>
    </div>
    <h1>AFET<br/><em>TÜRLERİ</em></h1>
    <p class="page-hero-sub">Türkiye'de karşılaşılabilecek tüm doğal ve insan kaynaklı afetler hakkında kapsamlı bilgi, hazırlık rehberleri ve acil eylem planları.</p>
  </div>
</section>

<!-- FILTER BAR -->
<div class="filter-bar">
  <div class="container">
    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-between">
      <div class="d-flex gap-2 flex-wrap">
        <button class="filter-btn active" data-filter="all">Tümü</button>
        <button class="filter-btn" data-filter="jeolojik">Jeolojik</button>
        <button class="filter-btn" data-filter="hidrolojik">Hidrolojik</button>
        <button class="filter-btn" data-filter="meteorolojik">Meteorolojik</button>
        <button class="filter-btn" data-filter="yangin">Yangın</button>
        <button class="filter-btn" data-filter="teknolojik">Teknolojik</button>
      </div>
      <div class="search-wrap">
        <i class="bi bi-search"></i>
        <input id="searchInput" class="search-box" type="text" placeholder="Afet ara..." />
      </div>
    </div>
  </div>
</div>

<!-- MAIN CONTENT -->
<main style="padding: 3.5rem 0;">
  <div class="container">

    @if (Model.Featured != null)
    {
      <!-- Featured Kart -->
      <div class="sec-divider" data-animate>
        <span class="sec-divider-label">Öne Çıkan</span>
        <div class="sec-divider-line"></div>
      </div>

      <a asp-controller="Disaster" asp-action="Details" asp-route-slug="@Model.Featured.Slug"
         class="featured-card mb-5 d-block" data-animate>
        <div class="featured-img">
          <img src="@Model.Featured.ImageUrl" alt="@Model.Featured.Name" />
          <div class="featured-img-badge"><i class="bi bi-star-fill me-1"></i> Öne Çıkan</div>
        </div>
        <div class="featured-body">
          <div class="risk-badge @RiskBadgeClass(Model.Featured.RiskLevel)">
            <i class="bi @RiskIcon(Model.Featured.RiskLevel)"></i>
            @RiskLabel(Model.Featured.RiskLevel).ToUpper()
          </div>
          <h2>@Model.Featured.Name</h2>
          <p>@Model.Featured.ShortDescription</p>
          <div class="read-more">Detaylı Bilgi <i class="bi bi-arrow-right"></i></div>
        </div>
      </a>
    }

    <!-- Grid -->
    <div class="sec-divider" data-animate>
      <span class="sec-divider-label">Tüm Afet Türleri</span>
      <div class="sec-divider-line"></div>
      <span class="result-info ms-2" id="resultCount">
        <strong>@Model.Disasters.Count</strong> afet türü
      </span>
    </div>

    @if (!Model.Disasters.Any())
    {
      <div class="empty-state">
        <i class="bi bi-exclamation-circle"></i>
        <p>Henüz yayında afet bulunmuyor.</p>
      </div>
    }
    else
    {
      <div class="row g-4" id="disasterGrid">
        @foreach (var d in Model.Disasters)
        {
          <div class="col-md-6 col-lg-4 dis-col"
               data-cat="@d.Category"
               data-name="@d.Name.ToLower()"
               data-animate>
            <a asp-controller="Disaster" asp-action="Details" asp-route-slug="@d.Slug" class="dis-card">
              <div class="dis-card-img">
                <img src="@d.ImageUrl" alt="@d.Name" />
                <div class="dis-icon-overlay"><i class="bi @d.Icon"></i></div>
              </div>
              <div class="dis-card-body">
                <div class="risk-badge @RiskBadgeClass(d.RiskLevel) mb-2">
                  <i class="bi @RiskIcon(d.RiskLevel)"></i>
                  @RiskLabel(d.RiskLevel)
                </div>
                <h4>@d.Name</h4>
                <p>@d.ShortDescription</p>
              </div>
              <div class="dis-card-footer">
                <span class="module-count"><i class="bi bi-book me-1"></i>@d.ModuleCount modül</span>
                <span class="arrow">İncele <i class="bi bi-arrow-right"></i></span>
              </div>
            </a>
          </div>
        }
      </div>

      <div id="emptyState" style="display:none;" class="empty-state mt-4">
        <i class="bi bi-search"></i>
        <p>Arama kriterlerine uyan afet bulunamadı.</p>
      </div>
    }

  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Progress bar
  window.addEventListener('scroll', () => {
    const pct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
    document.getElementById('progress').style.width = pct + '%';
  });

  // Scroll animations
  const els = document.querySelectorAll('[data-animate]');
  const obs = new IntersectionObserver(entries => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 70);
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  els.forEach(el => obs.observe(el));

  // Filter + Search
  const cols = document.querySelectorAll('.dis-col');
  const btns = document.querySelectorAll('.filter-btn');
  const searchInput = document.getElementById('searchInput');
  const resultCount = document.getElementById('resultCount');
  const emptyState  = document.getElementById('emptyState');
  let activeFilter = 'all';

  function applyFilters() {
    const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
    let count = 0;
    cols.forEach(col => {
      const cat  = col.dataset.cat;
      const name = col.dataset.name;
      const matchCat = activeFilter === 'all' || cat === activeFilter;
      const matchQ   = !q || name.includes(q);
      if (matchCat && matchQ) { col.classList.remove('hidden'); count++; }
      else { col.classList.add('hidden'); }
    });
    if (resultCount) resultCount.innerHTML = `<strong>${count}</strong> afet türü`;
    if (emptyState) emptyState.style.display = count === 0 ? 'block' : 'none';
  }

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.filter;
      applyFilters();
    });
  });

  if (searchInput) searchInput.addEventListener('input', applyFilters);
</script>
</body>
</html>
