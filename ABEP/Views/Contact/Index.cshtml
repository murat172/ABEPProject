@model ContactModel

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>İletişim – AfetBilinç</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;1,300&family=Barlow+Condensed:wght@500;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

  <style>
    :root {
      --red:    #C0392B;
      --red-dk: #922B21;
      --amber:  #D35400;
      --dark:   #0D0D0D;
      --mid:    #1A1A1A;
      --surface:#242424;
      --border: rgba(255,255,255,.07);
      --muted:  #888;
      --light:  #F5F1EC;
      --accent: #E74C3C;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--dark);
      color: var(--light);
      font-family: 'Barlow', sans-serif;
      font-weight: 300;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: .4;
    }

    /* ── NAVBAR ── */
    .navbar {
      background: rgba(13,13,13,.95);
      border-bottom: 1px solid rgba(192,57,43,.25);
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(8px);
    }
    .navbar-brand { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 2px; color: var(--light) !important; }
    .navbar-brand span { color: var(--accent); }
    .nav-link { color: rgba(245,241,236,.7) !important; font-size: .85rem; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; transition: color .2s; padding: .4rem .8rem !important; }
    .nav-link:hover, .nav-link.active { color: var(--accent) !important; }
    .btn-nav-alert { background: var(--red); color: #fff; font-size: .78rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; border: none; padding: .45rem 1.1rem; border-radius: 2px; transition: background .2s; text-decoration: none; }
    .btn-nav-alert:hover { background: var(--red-dk); color: #fff; }

    /* ── PAGE HEADER ── */
    .page-header {
      position: relative;
      padding: 5rem 0 4rem;
      overflow: hidden;
    }
    .page-header::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(192,57,43,.10) 0%, transparent 60%);
      pointer-events: none;
    }
    .page-header-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: .6rem;
    }
    .page-header h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 7vw, 5.5rem);
      letter-spacing: 3px;
      line-height: 1;
      margin-bottom: 1rem;
    }
    .page-header p {
      font-size: 1.05rem;
      color: rgba(245,241,236,.65);
      max-width: 520px;
      line-height: 1.7;
    }

    /* ── EMERGENCY STRIP ── */
    .emergency-strip {
      background: rgba(192,57,43,.12);
      border-top: 1px solid rgba(192,57,43,.3);
      border-bottom: 1px solid rgba(192,57,43,.3);
      padding: 1rem 0;
    }
    .emergency-strip-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .emergency-msg {
      display: flex;
      align-items: center;
      gap: .75rem;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .82rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #E74C3C;
    }
    .emergency-msg i { font-size: 1.1rem; animation: pulse 1.5s ease-in-out infinite; }
    @@keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:.4;} }
    .emergency-nums {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .e-num-btn {
      display: flex;
      align-items: center;
      gap: .4rem;
      background: var(--red);
      color: #fff;
      text-decoration: none;
      padding: .45rem 1.1rem;
      border-radius: 2px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .82rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transition: background .2s;
    }
    .e-num-btn:hover { background: var(--red-dk); color: #fff; }
    .e-num-btn.outline { background: transparent; border: 1px solid rgba(192,57,43,.5); color: #E74C3C; }
    .e-num-btn.outline:hover { background: rgba(192,57,43,.15); }

    /* ── LAYOUT ── */
    .contact-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 3rem;
      padding: 3.5rem 0 5rem;
      align-items: start;
    }

    /* ── FORM CARD ── */
    .form-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
    }
    .form-card-header {
      padding: 1.75rem 2rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: .75rem;
    }
    .form-card-header-icon {
      width: 42px;
      height: 42px;
      background: rgba(231,76,60,.12);
      border: 1px solid rgba(231,76,60,.2);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .form-card-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.5rem;
      letter-spacing: 2px;
    }
    .form-card-subtitle {
      font-size: .8rem;
      color: var(--muted);
      margin-top: .1rem;
    }
    .form-card-body { padding: 2rem; }

    /* Tabs */
    .topic-tabs {
      display: flex;
      gap: .5rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .topic-tab {
      background: var(--mid);
      border: 1px solid var(--border);
      color: rgba(245,241,236,.6);
      padding: .4rem .9rem;
      border-radius: 2px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all .2s;
    }
    .topic-tab:hover { border-color: rgba(231,76,60,.35); color: var(--light); }
    .topic-tab.active { background: rgba(231,76,60,.12); border-color: var(--accent); color: var(--accent); }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label-custom {
      display: block;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: .45rem;
    }
    .form-control-custom {
      width: 100%;
      background: var(--mid);
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--light);
      padding: .75rem 1rem;
      font-family: 'Barlow', sans-serif;
      font-size: .93rem;
      font-weight: 300;
      transition: border-color .2s, box-shadow .2s;
      outline: none;
    }
    .form-control-custom:focus { border-color: rgba(231,76,60,.5); box-shadow: 0 0 0 3px rgba(231,76,60,.07); }
    .form-control-custom::placeholder { color: rgba(136,136,136,.6); }
    textarea.form-control-custom { resize: vertical; min-height: 140px; }
    select.form-control-custom { appearance: none; cursor: pointer; }

    .char-count { font-size: .72rem; color: var(--muted); text-align: right; margin-top: .3rem; }
    .char-count.warn { color: var(--amber); }
    .char-count.limit { color: var(--accent); }

    .btn-submit {
      background: var(--red);
      color: #fff;
      border: none;
      padding: .8rem 2rem;
      border-radius: 2px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .88rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .2s;
      display: inline-flex;
      align-items: center;
      gap: .5rem;
    }
    .btn-submit:hover { background: var(--red-dk); }
    .btn-submit:disabled { opacity: .5; cursor: not-allowed; }

    /* ── SIDEBAR ── */
    .contact-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }

    .info-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
      opacity: 0;
      transform: translateY(18px);
    }
    .info-card.visible { opacity: 1; transform: translateY(0); transition: opacity .45s ease, transform .45s ease; }

    .info-card-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: rgba(245,241,236,.4);
    }
    .info-card-body { padding: 1.25rem; }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: .85rem;
      padding: .85rem 0;
      border-bottom: 1px solid var(--border);
    }
    .contact-item:last-child { border-bottom: none; padding-bottom: 0; }
    .contact-item:first-child { padding-top: 0; }
    .contact-item-icon {
      width: 36px;
      height: 36px;
      background: rgba(231,76,60,.1);
      border: 1px solid rgba(231,76,60,.2);
      border-radius: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      font-size: .95rem;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .contact-item-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: .2rem;
    }
    .contact-item-value {
      font-size: .92rem;
      color: rgba(245,241,236,.85);
      font-weight: 400;
    }
    .contact-item-value a { color: inherit; text-decoration: none; transition: color .2s; }
    .contact-item-value a:hover { color: var(--accent); }

    /* Working hours */
    .hours-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: .5rem 0;
      border-bottom: 1px solid var(--border);
      font-size: .85rem;
    }
    .hours-row:last-child { border-bottom: none; }
    .hours-day { color: rgba(245,241,236,.6); }
    .hours-time { font-weight: 500; color: rgba(245,241,236,.85); }
    .hours-badge {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: .2rem .5rem;
      border-radius: 2px;
    }
    .badge-open { background: rgba(46,204,113,.15); color: #2ECC71; border: 1px solid rgba(46,204,113,.25); }
    .badge-closed { background: rgba(136,136,136,.12); color: var(--muted); border: 1px solid var(--border); }

    /* Social */
    .social-links { display: flex; gap: .65rem; flex-wrap: wrap; }
    .social-btn {
      display: flex;
      align-items: center;
      gap: .4rem;
      background: var(--mid);
      border: 1px solid var(--border);
      color: rgba(245,241,236,.6);
      padding: .5rem .9rem;
      border-radius: 2px;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-decoration: none;
      transition: all .2s;
      text-transform: uppercase;
    }
    .social-btn:hover { border-color: rgba(231,76,60,.35); color: var(--accent); }

    /* FAQ */
    .faq-item {
      border-bottom: 1px solid var(--border);
    }
    .faq-item:last-child { border-bottom: none; }
    .faq-q {
      padding: 1rem 0;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .85rem;
      font-weight: 700;
      letter-spacing: .5px;
      color: rgba(245,241,236,.8);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .5rem;
      transition: color .2s;
    }
    .faq-q:hover { color: var(--accent); }
    .faq-q i { font-size: .8rem; color: var(--accent); flex-shrink: 0; transition: transform .25s; }
    .faq-q.open i { transform: rotate(180deg); }
    .faq-a {
      font-size: .85rem;
      line-height: 1.7;
      color: rgba(245,241,236,.6);
      overflow: hidden;
      max-height: 0;
      transition: max-height .3s ease, padding .3s ease;
    }
    .faq-a.open { max-height: 200px; padding-bottom: 1rem; }

    /* ── TOAST ── */
    .toast-custom {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #1e3a1e;
      border: 1px solid rgba(46,204,113,.3);
      border-radius: 4px;
      padding: 1rem 1.5rem;
      color: #2ECC71;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: .88rem;
      font-weight: 700;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: .6rem;
      z-index: 9999;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity .3s, transform .3s;
      pointer-events: none;
    }
    .toast-custom.show { opacity: 1; transform: translateY(0); }

    /* ── FOOTER ── */
    footer {
      background: var(--mid);
      border-top: 1px solid var(--border);
      padding: 4rem 0 2rem;
      position: relative;
    }
    .text-muted{
  color: var(--muted) !important;
}
    .footer-brand { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 2px; }
    .footer-brand span { color: var(--accent); }
    footer p { font-size: .9rem; color: var(--muted); line-height: 1.6; }
    .footer-heading { font-family: 'Barlow Condensed', sans-serif; font-size: .72rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
    .footer-links { list-style: none; }
    .footer-links li { margin-bottom: .5rem; }
    .footer-links a { color: var(--muted); text-decoration: none; font-size: .9rem; transition: color .2s; }
    .footer-links a:hover { color: var(--accent); }
    .footer-bottom { border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.5rem; font-size: .82rem; color: var(--muted); }
    .footer-bottom a { color: var(--muted); text-decoration: none; }
    .footer-bottom a:hover { color: var(--accent); }

    [data-animate] { opacity: 0; transform: translateY(18px); transition: opacity .45s ease, transform .45s ease; }
    [data-animate].visible { opacity: 1; transform: translateY(0); }

    @@media (max-width: 992px) {
      .contact-layout { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; gap: 0; }
    }
  </style>
</head>
<body>

<!-- PAGE HEADER -->
<div class="page-header">
  <div class="container" style="position:relative;z-index:2;">
    <div class="page-header-label"><i class="bi bi-envelope me-1"></i> Bize Ulaşın</div>
    <h1>İletişim</h1>
    <p>Sorularınız, önerileriniz veya iş birliği talepleriniz için ekibimizle doğrudan iletişime geçebilirsiniz.</p>
  </div>
</div>

<div class="container">
  <div class="contact-layout">

    <!-- LEFT: FORM -->
    <div data-animate>
      <div class="form-card">
        <div class="form-card-header">
          <div class="form-card-header-icon"><i class="bi bi-chat-dots"></i></div>
          <div>
            <div class="form-card-title">Mesaj Gönder</div>
            <div class="form-card-subtitle">En kısa sürede yanıt vereceğiz.</div>
          </div>
        </div>
        <form method="post" asp-controller="Contact" asp-action="Contact" data-ajax-contact>
          @Html.AntiForgeryToken()
          <div class="form-card-body">

            <div class="form-row">
              <div class="form-group">
                <label class="form-label-custom">Ad Soyad <span style="color:var(--accent);">*</span></label>
                <input type="text" class="form-control-custom" asp-for="FullName" />
                <span asp-validation-for="FullName" data-val-span="FullName" style="color:#ef4444;font-size:.78rem;margin-top:.3rem;display:block;"></span>
              </div>
              <div class="form-group">
                <label class="form-label-custom">E-posta <span style="color:var(--accent);">*</span></label>
                <input type="email" class="form-control-custom" asp-for="Email" />
                <span asp-validation-for="Email" data-val-span="Email" style="color:#ef4444;font-size:.78rem;margin-top:.3rem;display:block;"></span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label-custom">Konu <span style="color:var(--accent);">*</span></label>
              <input type="text" class="form-control-custom" asp-for="Subject" />
              <span asp-validation-for="Subject" data-val-span="Subject" style="color:#ef4444;font-size:.78rem;margin-top:.3rem;display:block;"></span>
            </div>

            <div class="form-group">
              <label class="form-label-custom">Mesajınız <span style="color:var(--accent);">*</span></label>
              <textarea class="form-control-custom" asp-for="Message" maxlength="2000" oninput="updateCount()"></textarea>
              <span asp-validation-for="Message" data-val-span="Message" style="color:#ef4444;font-size:.78rem;margin-top:.3rem;display:block;"></span>
              <div class="char-count" id="cCount">0 / 2000</div>
            </div>

            <div class="form-check d-flex align-items-start gap-2 mb-4">
              <input class="form-check-input mt-1" type="checkbox" id="cGdpr" style="flex-shrink:0;accent-color:var(--accent);">
              <label class="form-check-label" for="cGdpr" style="font-size:.83rem;color:rgba(245,241,236,.6);cursor:pointer;">
                Kişisel verilerimin <a href="#" style="color:var(--accent);">Gizlilik Politikası</a> kapsamında işlenmesini kabul ediyorum.
              </label>
            </div>

            <button class="btn-submit" id="cBtn" type="submit">
              <i class="bi bi-send"></i> Mesaj Gönder
            </button>
          </div>
        </form>
      </div>

      <!-- FAQ -->
      @await Html.PartialAsync(partialViewName: "_Question")
    </div>

    <!-- RIGHT: SIDEBAR -->
    <div class="contact-sidebar">

      <div class="info-card" data-animate>
        <div class="info-card-header">İletişim Bilgileri</div>
        <div class="info-card-body">
          <div class="contact-item">
            <div class="contact-item-icon"><i class="bi bi-envelope-fill"></i></div>
            <div>
              <div class="contact-item-label">E-posta</div>
              <div class="contact-item-value"><a href="mailto:iletisim@afetbilincx.org">iletisim@abep.org</a></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon"><i class="bi bi-telephone-fill"></i></div>
            <div>
              <div class="contact-item-label">Telefon</div>
              <div class="contact-item-value"><a href="tel:+902121234567">+90 (212) 123 45 67</a></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon"><i class="bi bi-geo-alt-fill"></i></div>
            <div>
              <div class="contact-item-label">Adres</div>
              <div class="contact-item-value">Maslak Mah. Büyükdere Cad. No:55<br>Sarıyer / İstanbul</div>
            </div>
          </div>
        </div>
      </div>

      <div class="info-card" data-animate>
        <div class="info-card-header">Sosyal Medya</div>
        <div class="info-card-body">
          <div class="social-links">
            <a href="#" class="social-btn"><i class="bi bi-twitter-x"></i> Twitter</a>
            <a href="#" class="social-btn"><i class="bi bi-instagram"></i> Instagram</a>
            <a href="#" class="social-btn"><i class="bi bi-youtube"></i> YouTube</a>
            <a href="#" class="social-btn"><i class="bi bi-linkedin"></i> LinkedIn</a>
          </div>
          <p style="font-size:.78rem;color:var(--muted);margin-top:1rem;line-height:1.6;">
            Güncel afet haberleri ve eğitim içerikleri için sosyal medya hesaplarımızı takip edin.
          </p>
        </div>
      </div>

    </div>
  </div>
</div>


<!-- TOAST - Başarı -->
<div class="toast-custom" id="toastSuccess" style="background:#1a2e1a;border:1px solid rgba(34,197,94,.3);color:#4ade80;">
  <i class="bi bi-check-circle-fill"></i> Mesajınız alındı! En kısa sürede yanıt vereceğiz.
</div>

<!-- TOAST - Hata -->
<div class="toast-custom" id="toastError" style="background:#2e1a1a;border:1px solid rgba(239,68,68,.3);color:#f87171;">
  <i class="bi bi-exclamation-triangle-fill"></i> <span id="toastErrorMsg">Lütfen tüm alanları doldurunuz.</span>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Animate
  const els = document.querySelectorAll('[data-animate]');
  const obs = new IntersectionObserver(entries => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.06 });
  els.forEach(el => obs.observe(el));

  // Char count
  function updateCount() {
    const ta = document.querySelector('[name="Message"]');
    const cc = document.getElementById('cCount');
    if (!ta || !cc) return;
    const len = ta.value.length;
    cc.textContent = len + ' / 2000';
    cc.className = 'char-count' + (len > 1800 ? ' limit' : len > 1400 ? ' warn' : '');
  }

  // Toast göster
  function showToast(id, duration) {
    const t = document.getElementById(id);
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), duration || 4000);
  }

  // Hata span temizle
  function clearErrors() {
    document.querySelectorAll('[data-val-span]').forEach(s => s.textContent = '');
    document.querySelectorAll('.form-control-custom').forEach(i => i.style.borderColor = '');
  }

  // Hata span göster
  function showFieldError(field, msg) {
    const span = document.querySelector('[data-val-span="' + field + '"]');
    if (span) span.textContent = msg;
    const input = document.querySelector('[name="' + field + '"]');
    if (input) input.style.borderColor = '#ef4444';
  }

  // AJAX Form Gönder
  document.querySelector('form[data-ajax-contact]').addEventListener('submit', async function(e) {
    e.preventDefault();

    clearErrors();

    const gdpr = document.getElementById('cGdpr');
    if (!gdpr.checked) {
      document.getElementById('toastErrorMsg').textContent = 'Gizlilik politikasını kabul etmeniz gerekmektedir.';
      showToast('toastError');
      return;
    }

    const btn = document.getElementById('cBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Gönderiliyor...';

    const formData = new FormData(this);
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    try {
      const res = await fetch(this.action, {
        method: 'POST',
        headers: { 'RequestVerificationToken': token },
        body: formData
      });

      const data = await res.json();

      if (data.success) {
        // Formu temizle
        this.reset();
        updateCount();
        showToast('toastSuccess');
      } else {
        // Hataları göster
        if (data.errors) {
          Object.keys(data.errors).forEach(field => {
            showFieldError(field, data.errors[field]);
          });
        }
        document.getElementById('toastErrorMsg').textContent = 'Lütfen tüm zorunlu alanları doldurunuz.';
        showToast('toastError');
      }
    } catch {
      document.getElementById('toastErrorMsg').textContent = 'Bir hata oluştu, lütfen tekrar deneyin.';
      showToast('toastError');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send"></i> Mesaj Gönder';
    }
  });

  // FAQ
  function toggleFaq(el) {
    const ans = el.nextElementSibling;
    const isOpen = ans.classList.contains('open');
    document.querySelectorAll('.faq-a.open').forEach(a => { a.classList.remove('open'); a.previousElementSibling.classList.remove('open'); });
    if (!isOpen) { ans.classList.add('open'); el.classList.add('open'); }
  }
</script>
</body>
</html>
