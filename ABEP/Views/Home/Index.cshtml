@model EmergencyModel

@{
    ViewData["Title"] = "Ana Sayfa";
}


<!--Hero-->
@await Html.PartialAsync("_Hero", (HeroModel)ViewData["Hero"]!)

<!-- ── DISASTER TYPES ── -->
@await Html.PartialAsync("_Section",
    ViewData["Top6Disasters"] as List<ABEP.Models.DisasterModel>
    ?? new List<ABEP.Models.DisasterModel>())


<!-- ── HOW TO PREPARE ── -->
@await Html.PartialAsync(partialViewName: "_HowToPrepare", (HowToPrepareModel)ViewData["HowToPrepare"]!)


<section class="kit" id="canta">
  <div class="container">
    <div class="row g-5 align-items-start">
      <div class="col-lg-6" data-animate>
        <div class="section-label">@Model.Eyebrow</div>
        <h2 class="section-title mb-3">@Model.Title1</h2>
        <p class="section-desc mb-4">@Model.Description1</p>
        <ul class="kit-list">
          @foreach (var item in (List<EmergencyKitItemModel>)ViewData["KitItems"]!)
          {
              <li><i class="bi @item.Icon"></i> @item.Item</li>
          }
        </ul>

        @* Acil numaralar*@
        <div class="kit-callout">
          <h4>@Model.Title2</h4>
          <p>@Model.Description2</p>
        </div>
      </div>
      <div class="col-lg-5 offset-lg-1" data-animate>
        <div class="section-label">Acil Numaralar</div>
        <h3 class="section-title mb-4" style="font-size:2rem;">Hızlı Erişim</h3>
        <div class="d-flex flex-column gap-3">
          @foreach(var phone in (List<EmergencyPhoneModel>)ViewData["Phones"]!){
            <div class="footer-emergency w-100" style="display:flex; justify-content:space-between; align-items:center;">
              <div class="lbl">@phone.PhoneName</div>
              <div class="num" style="color:#e63946; font-weight:700; margin-left:auto;">@phone.Phone</div>
          </div>
          }
        </div>
      </div>
    </div>
  </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  // Progress bar
  window.addEventListener('scroll', () => {
    const pct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
    document.getElementById('progress').style.width = pct + '%';
  });

  // Scroll animations
  const els = document.querySelectorAll('[data-animate]');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  els.forEach(el => obs.observe(el));
</script>
