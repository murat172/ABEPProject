@model HeroModel
@{
    var imgUrl = string.IsNullOrEmpty(Model.ImagePath)
        ? "https://images.unsplash.com/photo-1517022812141-23620dba5c23?w=1600&q=60"
        : Model.ImagePath;

    var userCount     = (int)(ViewData["StatUserCount"]     ?? 0);
    var disasterCount = (int)(ViewData["StatDisasterCount"] ?? 0);
    var catCount      = (int)(ViewData["StatCategoryCount"] ?? 5);

    
    string FormatCount(int n)
    {
        if (n >= 1_000_000) return $"{n / 1_000_000}M+";
        if (n >= 1_000)     return $"{n / 1_000}K+";
        return n.ToString();
    }
}

<section class="hero">
  <div class="hero-bg" style="background:
        linear-gradient(135deg, rgba(13,13,13,1) 40%, rgba(192,57,43,0.12) 100%),
        url('@imgUrl') center/cover no-repeat;">
  </div>
    <div class="container hero-content py-5">
      <div class="row">
        <div class="col-lg-7">
          <div class="hero-eyebrow">@Model.Eyebrow</div>
          <h1>
            @Model.TitleLine1<br/>
            <em>@Model.TitleLine2</em><br/>
            @Model.TitleLine3
          </h1>
          <p class="hero-sub">
            @Model.SubTitle
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href="@Model.Btn1Url" class="btn-primary-custom">@Model.Btn1Text</a>
            <a href="@Model.Btn2Url" class="btn-outline-custom">@Model.Btn2Text</a>
          </div>
          <div class="hero-stat-row flex-wrap">
            <div>
              <div class="hero-stat-num">@FormatCount(userCount)</div>
              <div class="hero-stat-label">Kullanıcı</div>
            </div>
            <div>
              <div class="hero-stat-num">@disasterCount</div>
              <div class="hero-stat-label">Afet</div>
            </div>
            <div>
              <div class="hero-stat-num">@catCount</div>
              <div class="hero-stat-label">Afet Kategorisi</div>
            </div>
          </div>
        </div>
      </div>
  </div>
</section>
